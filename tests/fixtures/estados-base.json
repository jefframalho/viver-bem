  "ST_DIA": "const ST_DIA = {nao:[\"Não iniciados\",\"var(--blue)\"],atrasado:[\"Atrasados\",\"var(--bad)\"],andamento:[\"Em andamento\",\"var(--copper)\"],concluido:[\"Concluídos\",\"var(--ok)\"],falta:[\"Faltas\",\"var(--muted)\"]}",
