rules_version = '2';
// Regras do banco do Sistema Viver Bem
service cloud.firestore {
  match /databases/{db}/documents {
    function signed()  { return request.auth != null; }
    function me()      { return get(/databases/$(db)/documents/usuarios/$(request.auth.uid)).data; }
    function temPerfil(){ return signed() && exists(/databases/$(db)/documents/usuarios/$(request.auth.uid)); }
    function isAdmin() { return temPerfil() && me().role == 'admin'; }
    function isProf()  { return temPerfil() && me().role == 'prof' && me().get('profId', '') is string && me().get('profId', '').size() > 0; }
    function isPac()   { return temPerfil() && me().role == 'paciente' && me().get('pacId', '') is string && me().get('pacId', '').size() > 0; }
    function meuProf() { return isProf() && resource.data.profId == me().profId; }
    function only(keys){ return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Contas públicas usam Authentication; nenhum CPF/protocolo concede acesso sozinho.
    function verified() { return signed() && request.auth.token.email_verified == true; }
    function owns(d) { return verified() && d.get('ownerUid', '') == request.auth.uid; }
    function cuida(pacId) {
      return isProf() && pacId is string && pacId != ''
        && me().profId in get(/databases/$(db)/documents/pacientes/$(pacId)).data.get('profIds', []);
    }
    function candidateOwner(id) {
      return id is string && id != '' && owns(get(/databases/$(db)/documents/candidatos/$(id)).data);
    }
    function signs(d) {
      return verified() && (d.get('signerUid', '') == request.auth.uid
        || (d.tipo == 'autonomo' && candidateOwner(d.refId)));
    }
    function upload(d) {
      return d.keys().hasOnly(['id','cand','prof','tipo','nome','data','criado','atualizado'])
        && d.data is string && d.data.size() > 0 && d.data.size() < 1000000
        && d.nome is string && d.nome.size() <= 255
        && d.tipo in ['identidade','conselho','endereco','selfie','curriculo'];
    }
    function proUpload(d) { return isProf() && d.get('prof', '') == me().profId && d.get('cand', '') == ''; }
    function candidateUpload(d) {
      return verified() && d.get('prof', '') == '' && d.get('cand', '') != ''
        && owns(getAfter(/databases/$(db)/documents/candidatos/$(d.cand)).data);
    }

    // Dados da empresa: leitura pública (contratos, links e site), escrita só da administração
    match /config/{id}       { allow get: if id == 'empresa' || isAdmin(); allow list, write: if isAdmin(); }
    // Quem pode entrar e com qual perfil
    match /usuarios/{uid}    { allow get: if signed() && (request.auth.uid == uid || isAdmin()); allow list, write: if isAdmin(); }

    // Candidatos: conta verificada vinculada; protocolo apenas localiza, nunca autoriza
    match /candidatos/{id}   {
      allow create: if verified() && owns(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'recebido'
        && request.resource.data.notas == ''
        && !request.resource.data.keys().hasAny(['contratoId','docsOk','reenvio']);
      allow get: if isAdmin() || owns(resource.data)
        || (isProf() && get(/databases/$(db)/documents/profissionais/$(me().profId)).data.get('candId', '') == id);
      allow list, delete: if isAdmin();
      allow update: if isAdmin() || (owns(resource.data) && only(['reenvio','atualizado']) && request.resource.data.reenvio is list && resource.data.reenvio.hasAll(request.resource.data.reenvio) && request.resource.data.reenvio.size() < resource.data.reenvio.size());
    }
    match /documentos/{id} {
      allow create: if isAdmin() || (upload(request.resource.data)
        && (proUpload(request.resource.data) || candidateUpload(request.resource.data)));
      allow update: if isAdmin() || (upload(request.resource.data)
        && only(['nome','data','criado','atualizado'])
        && (proUpload(resource.data) || (candidateUpload(resource.data)
          && resource.data.tipo in get(/databases/$(db)/documents/candidatos/$(resource.data.cand)).data.get('reenvio', []))));
      allow read: if isAdmin() || proUpload(resource.data);
      allow delete: if isAdmin();
    }
    match /curriculos/{id}   { allow read, write: if isAdmin(); }
    // Solicitações de atendimento: link público e área da família
    match /solicitacoes/{id} { allow create: if request.resource.data.status == 'novo'
      && request.resource.data.keys().hasOnly(['id','tipo','status','nome','tel','cidade','servico','paciente','msg','empresa','cnpj','cargo','email','regiao','criado','atualizado'])
      && request.resource.data.tipo in ['familia','operadora']
      && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 200
      && request.resource.data.tel is string && request.resource.data.tel.size() >= 8 && request.resource.data.tel.size() <= 30
      && request.resource.data.get('msg', '') is string && request.resource.data.get('msg', '').size() <= 4000; allow read, update, delete: if isAdmin(); }

    // Contratos: link exige conta verificada e vínculo do assinante
    match /contratos/{id} {
      allow get: if isAdmin() || signs(resource.data);
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (signs(resource.data) && resource.data.status == 'pendente'
        && request.resource.data.status == 'assinado' && only(['status','assinatura','atualizado'])
        && request.resource.data.assinatura.keys().hasOnly(['uid','nome','cpf','em','hash','disp'])
        && request.resource.data.assinatura.uid == request.auth.uid
        && request.resource.data.assinatura.nome == (resource.data.tipo == 'autonomo' ? resource.data.dados.nome : resource.data.dados.respNome)
        && request.resource.data.assinatura.cpf == (resource.data.tipo == 'autonomo' ? resource.data.dados.cpf : resource.data.dados.respCpf)
        && request.resource.data.assinatura.em is string
        && request.resource.data.assinatura.hash is string
        && request.resource.data.assinatura.disp is string);
    }

    // Plantões: profissional vê e evolui os próprios; a família vê os do seu paciente
    match /plantoes/{id} {
      allow read: if isAdmin() || meuProf() || (isPac() && resource.data.pacId == me().pacId);
      allow update: if isAdmin()
        || (meuProf() && only(['status','evolucao','chegada','saida','tentativas','tarefas','materiais','atualizado']));
      allow create, delete: if isAdmin();
    }

    // Pacientes: a família lê só o seu
    match /pacientes/{id}     { allow get: if isAdmin() || cuida(id) || (isPac() && me().pacId == id); allow list: if isAdmin() || (isProf() && me().profId in resource.data.get('profIds', [])); allow write: if isAdmin(); }
    match /profissionais/{id} {
      allow read: if isAdmin() || (isProf() && me().profId == id);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isProf() && me().profId == id && only(['tel','email','pix','areas','disp','docs','cep','rua','numero','complemento','bairro','cidade','uf','referencia','endereco','atualizado']));
    }
    match /operadoras/{id}    { allow read, write: if isAdmin(); }

    // Teleconsultas
    match /consultas/{id} {
      allow read: if isAdmin() || meuProf() || (isPac() && resource.data.pacId == me().pacId);
      allow create: if isAdmin() || (isPac() && request.resource.data.pacId == me().pacId && request.resource.data.status == 'solicitada' && request.resource.data.pagamento == 'pendente'
        && request.resource.data.keys().hasOnly(['id','pacId','profId','profNome','esp','data','hora','dur','valor','status','pagamento','sala','obs','consentimento','criado','atualizado'])
        && request.resource.data.valor == get(/databases/$(db)/documents/config/empresa).data.get('teleValores', {}).get(request.resource.data.esp, 0)
        && get(/databases/$(db)/documents/agendaTele/$(request.resource.data.profId)).data.ativo == true);
      allow update: if isAdmin()
        || (meuProf() && only(['evolucao','orientacoes','documentos','status','retornoEm','atualizado']))
        || (isPac() && resource.data.pacId == me().pacId && only(['consentimento','status','atualizado']) && request.resource.data.status in [resource.data.status, 'cancelada']);
      allow delete: if isAdmin();
    }
    // Agenda de teleconsulta dos profissionais (nome, especialidade e horários livres)
    match /agendaTele/{id} { allow read: if temPerfil(); allow write: if isAdmin(); }
    // Monitoramento de crônicos
    match /medicoes/{id} {
      allow read: if isAdmin() || cuida(resource.data.pacId) || (isPac() && resource.data.pacId == me().pacId);
      allow create: if isAdmin() || cuida(request.resource.data.pacId) || (isPac() && request.resource.data.pacId == me().pacId);
      allow update, delete: if isAdmin();
    }
    match /intercorrencias/{id} { allow read: if isAdmin() || cuida(resource.data.pacId); allow create: if isAdmin() || cuida(request.resource.data.pacId); allow update, delete: if isAdmin(); }

    // Estoque e faturamento de convênios
    match /produtos/{id}      { allow read: if isAdmin() || isProf(); allow write: if isAdmin(); }
    match /movEstoque/{id}    { allow read: if isAdmin(); allow create: if isAdmin() || (isProf() && request.resource.data.tipo == 'saida'); allow update, delete: if isAdmin(); }
    match /lotes/{id}         { allow read, write: if isAdmin(); }
    match /inventarios/{id}   { allow read, write: if isAdmin(); }
    match /tuss/{id}          { allow read: if isAdmin() || isProf(); allow write: if isAdmin(); }
    match /mapTuss/{id}       { allow read, write: if isAdmin(); }

    // Cadastros da operação
    match /funcionarios/{id}  { allow read, write: if isAdmin(); }
    match /coordenadores/{id} { allow read: if isAdmin() || isProf(); allow write: if isAdmin(); }
    match /organizacoes/{id}  { allow read: if isAdmin() || isProf(); allow write: if isAdmin(); }
    match /rotas/{id}         { allow read: if isAdmin() || isProf(); allow write: if isAdmin(); }
    // Avisos da administração para a equipe de campo
    match /avisos/{id}        { allow read: if signed(); allow write: if isAdmin(); }

    // Chat: cada profissional só vê e escreve na própria conversa
    match /mensagens/{id} {
      allow read: if isAdmin() || meuProf();
      allow create: if isAdmin() || (isProf() && request.resource.data.profId == me().profId && request.resource.data.de == 'prof');
      allow update: if isAdmin() || (meuProf() && only(['lida','atualizado']));
      allow delete: if isAdmin();
    }
    // Folgas e férias: o profissional avisa as suas
    match /indisponibilidades/{id} {
      allow read: if isAdmin() || meuProf();
      allow create: if isAdmin() || (isProf() && request.resource.data.profId == me().profId);
      allow update: if isAdmin() || (meuProf() && only(['de','ate','motivo','obs','profNome','atualizado'])); allow delete: if isAdmin() || meuProf();
    }

    // Financeiro: só a administração. O profissional lê os próprios adiantamentos.
    match /despesas/{id}      { allow read, write: if isAdmin(); }
    match /adiantamentos/{id} { allow read: if isAdmin() || meuProf(); allow write: if isAdmin(); }
    match /lancamentos/{id}   { allow read, write: if isAdmin(); }
    match /extratoBanco/{id}  { allow read, write: if isAdmin(); }
    match /conferencias/{id}  { allow read, write: if isAdmin(); }

    // Auditoria do cliente: perfil/UID e horário do servidor verificados; não é prova independente da ação
    match /auditoria/{id}     { allow create: if temPerfil() && request.resource.data.keys().hasOnly(['id','em','uid','usuario','perfil','acao','colecao','docId','item','detalhe']) && request.resource.data.uid == request.auth.uid && request.resource.data.perfil == me().role && request.resource.data.usuario == me().nome && request.resource.data.em == request.time; allow read: if isAdmin(); }
  }
}

